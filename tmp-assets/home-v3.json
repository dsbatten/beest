align-items:center!important;gap:14px!important;padding:12px 14px!important}\n#bz-home .bz-fig-g{flex:0 0 112px!important;height:auto!important;justify-content:center!important}\n#bz-home .bz-fig-g svg{max-width:112px;height:auto}\n#bz-home .bz-fig-g span{font-size:11px!important}\n#bz-home .bz-fig-b{gap:2px!important;min-width:0}\n#bz-home .bz-fig-n{font-size:28px!important}\n#bz-home .bz-fig-t{font-size:14px!important}\n}\n@media (max-width:700px){\n#bz-home .bz-feature{margin-bottom:32px!important}\n#bz-home .bz-band-grid{padding-top:36px!important;padding-bottom:40px!important}\n#bz-home .bz-chai-band{display:grid!important;grid-template-columns:80px 1fr;column-gap:14px;row-gap:12px;align-items:center;border-top:1px solid rgba(238,242,245,.12);padding-top:28px!important}\n#bz-home .bz-chai-band > a:first-child{grid-column:1;grid-row:1}\n#bz-home .bz-chai-band img{width:80px!important;height:80px!important}\n#bz-home .bz-chai-band .bz-chai-text{display:contents}\n#bz-home .bz-chai-band h2{grid-column:2;grid-row:1;font-size:19px}\n#bz-home .bz-chai-band p{grid-column:1/3;grid-row:2;margin:0}\n#bz-home .bz-chai-band .bz-tip{grid-column:1/3;grid-row:3;justify-self:start}\n#bz-home .bz-chai-band p span{overflow-wrap:normal!important;white-space:nowrap}\n}\n</style>\n\n\n    <div class=\"bz-feature\" id=\"bz-feature\">\n      <a class=\"bz-feature-img\" id=\"bz-feature-img\" href=\"/articles/\" hidden><img id=\"bz-feature-imgtag\" alt=\"\" loading=\"lazy\" decoding=\"async\"></a>\n      <div class=\"bz-feature-inner\">\n        <span class=\"bz-kicker\" id=\"bz-feature-date\">Latest</span>\n        <h2><a id=\"bz-feature-title\" href=\"/articles/\">Latest article</a></h2>\n        <p id=\"bz-feature-excerpt\"></p>\n        <div class=\"bz-feature-links\"><a class=\"bz-more\" id=\"bz-feature-link\" href=\"/articles/\">Read the article \u2192</a><a class=\"bz-more\" id=\"bz-others\" href=\"/articles/\">Read other articles \u2192</a></div>\n      </div>\n    </div>\n\n    \n  </div>\n\n  <section class=\"bz-band\">\n    <div class=\"bz-wrap bz-band-grid\">\n      \n      <div class=\"bz-stack\">\n        <span class=\"bz-kicker\">Newsletter</span>\n        <h2>New research in your inbox</h2>\n        <a class=\"bz-pill\" href=\"https://newsletter.batcoinz.com/\" style=\"font-size:16px;padding:13px 24px\">Subscribe on Substack</a>\n      </div>\n      <div class=\"bz-chai bz-chai-band\">\n    <a href=\"lightning:soakedbobcat96@walletofsatoshi.com\"><img decoding=\"async\" src=\"https://batcoinz.com/wp-content/uploads/2026/11/buy-me-a-chai-lightning.png\" alt=\"Chai cup with a Lightning QR code\"></a>\n    <div class=\"bz-chai-text\">\n      <h2>If you got value from this research, buy me a chai</h2>\n      <p>Scan the cup with any Lightning wallet, or send sats to <span style=\"color:#EEF2F5\">soakedbobcat96@walletofsatoshi.com</span></p>\n      <a class=\"bz-tip\" href=\"lightning:soakedbobcat96@walletofsatoshi.com\">Tip with Lightning</a>\n    </div>\n  </div>\n    </div>\n  </section>\n\n  \n\n  <footer class=\"bz-wrap bz-footer\">\n    <span>\u00a9 <span id=\"bz-year\">2026</span> Batcoinz</span>\n    <span><a href=\"https://www.danielbatten.co\">Bitcoiner coaching</a> \u00b7 <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a> \u00b7 <a href=\"https://newsletter.batcoinz.com/\">Newsletter</a> \u00b7 <a href=\"/misinformation-archive/\">Misinformation archive</a></span>\n  </footer>\n</div>\n<script>\n(function () {\n  // Fills the latest-article box from the WordPress REST API and counts the other listed articles.\n  // Archive (39) and unlisted (41) posts are left out.\n  var MONTHS = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\n  var yel = document.getElementById(\"bz-year\"); if (yel) yel.textContent = new Date().getFullYear();\n  function fmt(d) { var t = new Date(d); return t.getDate() + \" \" + MONTHS[t.getMonth()] + \" \" + t.getFullYear(); }\n  function text(html) { var el = document.createElement(\"div\"); el.innerHTML = html; return (el.textContent || \"\").replace(/\\s+/g, \" \").trim(); }\n  fetch(\"/wp-json/wp/v2/posts?per_page=1&categories_exclude=39,41&_embed=wp:featuredmedia&_fields=date,link,title,excerpt,_links,_embedded\")\n    .then(function (r) {\n      var total = +r.headers.get(\"X-WP-Total\");\n      if (total > 1) document.getElementById(\"bz-others\").textContent = \"Read other articles (\" + (total - 1) + \") \u2192\";\n      return r.json();\n    })\n    .then(function (posts) {\n      if (!posts.length) return;\n      var f = posts[0];\n      document.getElementById(\"bz-feature-date\").textContent = \"Latest \u00b7 \" + fmt(f.date);\n      var t = document.getElementById(\"bz-feature-title\"); t.innerHTML = f.title.rendered; t.href = f.link;\n      document.getElementById(\"bz-feature-link\").href = f.link;\n      // The article's featured image, at a medium-large size rather than the full upload.\n      var m = f._embedded && f._embedded[\"wp:featuredmedia\"] && f._embedded[\"wp:featuredmedia\"][0];\n      if (m && m.source_url) {\n        var s = m.media_details && m.media_details.sizes, pick = s && (s.medium_large || s.large || s.full);\n        var img = document.getElementById(\"bz-feature-imgtag\"), box = document.getElementById(\"bz-feature-img\");\n        img.src = pick ? pick.source_url : m.source_url; img.alt = m.alt_text || \"\"; box.href = f.link; box.hidden = false;\n      }\n      var ex = text(f.excerpt.rendered).replace(/^Summary\\s+/i, \"\").replace(/\\s*(\\[\u2026\\]|\u2026|\\.\\.\\.)\\s*$/, \"\");\n      if (ex.length > 220) ex = ex.slice(0, 220).replace(/\\s+\\S*$/, \"\");\n      document.getElementById(\"bz-feature-excerpt\").textContent = ex + \"\u2026\";\n    })\n    .catch(function () {});\n})();\n</script>\n\n<style>\n/* Latest article: featured image on the left, text on the right. Newsletter button in its own colour. */\n#bz-home .bz-feature{display:flex!important;gap:36px;align-items:center}\n#bz-home .bz-feature-img{flex:0 0 42%;border-radius:12px;overflow:hidden}\n#bz-home .bz-feature-img img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}\n#bz-home .bz-feature-inner{flex:1;min-width:0}\n#bz-home a.bz-pill{background:#7FB2E8}\n#bz-home a.bz-pill:hover{background:#A9CCF0}\n@media (max-width:820px){#bz-home .bz-feature{flex-direction:column;align-items:stretch;gap:20px}#bz-home .bz-feature-img{flex-basis:auto}}\n</style>\n<!-- /wp:html -->"}
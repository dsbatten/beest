top:6px}\n</style>\n<script>\n(function () {\n  // Live mini chart: sustainable energy share from the BEEST tracker's daily-rebuilt history.json.\n  var svg = document.getElementById(\"bz-beest-svg\");\n  if (!svg) return;\n  var NS = \"http://www.w3.org/2000/svg\";\n  function el(tag, attrs, text) {\n    var e = document.createElementNS(NS, tag);\n    for (var k in attrs) e.setAttribute(k, attrs[k]);\n    if (text != null) e.textContent = text;\n    svg.appendChild(e);\n    return e;\n  }\n  fetch(\"https://beest.batcoinz.com/history.json\", { cache: \"no-store\" })\n    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })\n    .then(function (d) {\n      var rows = d.rows.filter(function (r, i) { return r.clean_share != null && (i % 5 === 0 || i === d.rows.length - 1); });\n      var W = 480, H = 350, L = 62, R = 14, T = 34, B = 30, GREEN = \"#5CC971\";\n      var t0 = Date.parse(rows[0].date), t1 = Date.parse(rows[rows.length - 1].date);\n      var x = function (t) { return L + (t - t0) / (t1 - t0) * (W - L - R); };\n      var y = function (v) { return T + (1 - v / 100) * (H - T - B); };\n      var font = \"font-family:inherit\";\n      el(\"text\", { x: L, y: 17, fill: \"#EEEEEE\", \"font-size\": 17, \"font-weight\": 600, style: font }, \"Bitcoin sustainable energy use\");\n      el(\"text\", { x: 11, y: (T + H - B) / 2, fill: \"#B8C0CC\", \"font-size\": 11, \"text-anchor\": \"middle\", transform: \"rotate(-90 11 \" + ((T + H - B) / 2) + \")\", style: font }, \"% of mining power\");\n      for (var v = 0; v <= 100; v += 20) {\n        el(\"line\", { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: v === 0 ? \"rgba(238,238,238,0.4)\" : \"rgba(238,238,238,0.09)\", \"stroke-width\": v === 0 ? 1.5 : 1 });\n        el(\"text\", { x: L - 8, y: y(v) + 4, fill: \"#B8C0CC\", \"font-size\": 13, \"text-anchor\": \"end\", style: font }, v + \"%\");\n      }\n      var y0 = new Date(t0).getUTCFullYear() + 1, y1 = new Date(t1).getUTCFullYear();\n      for (var yr = y0; yr <= y1; yr++) {\n        el(\"text\", { x: x(Date.UTC(yr, 0, 1)), y: H - 8, fill: \"#B8C0CC\", \"font-size\": 13, \"text-anchor\": \"middle\", style: font }, yr);\n      }\n      var dpath = rows.map(function (r, i) { return (i ? \"L\" : \"M\") + x(Date.parse(r.date)).toFixed(1) + \" \" + y(r.clean_share * 100).toFixed(1); }).join(\" \");\n      el(\"path\", { d: dpath, fill: \"none\", stroke: GREEN, \"stroke-width\": 2.6, \"stroke-linejoin\": \"round\" });\n      var last = rows[rows.length - 1], lv = last.clean_share * 100, lx = x(t1), ly = y(lv);\n      el(\"circle\", { cx: lx, cy: ly, r: 5, fill: GREEN, stroke: \"#092142\", \"stroke-width\": 2 });\n      el(\"text\", { x: lx, y: ly + 24, fill: \"#EEEEEE\", \"font-size\": 17, \"font-weight\": 700, \"text-anchor\": \"end\", style: font }, lv.toFixed(1) + \"%\");\n    })\n    .catch(function () { svg.parentNode.style.display = \"none\"; });\n})();\n</script></div>\n    <div class=\"bz-viz-chart\"><div class=\"bz-stack bz-beest\">\n        <a class=\"bz-beest-chart\" href=\"https://batcoinz.com/beest/intensity.html\" aria-label=\"Open the BEEST tracker: Bitcoin's net carbon intensity against the banking sector since September 2019\">\n          <svg id=\"bz-int-svg\" viewBox=\"0 0 480 384\" role=\"img\" aria-label=\"Bitcoin's net carbon intensity against the banking sector since September 2019\"></svg>\n        </a>\n      </div>\n<script>\n(function () {\n  // Live mini chart: Bitcoin's net carbon intensity against the banking sector, from the BEEST tracker's daily-rebuilt history.json.\n  var svg = document.getElementById(\"bz-int-svg\");\n  if (!svg) return;\n  var NS = \"http://www.w3.org/2000/svg\";\n  function el(tag, attrs, text) {\n    var e = document.createElementNS(NS, tag);\n    for (var k in attrs) e.setAttribute(k, attrs[k]);\n    if (text != null) e.textContent = text;\n    svg.appendChild(e);\n    return e;\n  }\n  fetch(\"https://beest.batcoinz.com/history.json\", { cache: \"no-store\" })\n    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })\n    .then(function (d) {\n      var all = d.rows.filter(function (r) { return r.gross_mt; });\n      var rows = all.filter(function (r, i) { return i % 5 === 0 || i === all.length - 1; });\n      var W = 480, H = 384, L = 62, R = 14, T = 34, B = 30, NET = \"#CC43D6\", GRID = \"#A9B4C2\", MAX = 700;\n      var t0 = Date.parse(rows[0].date), t1 = Date.parse(rows[rows.length - 1].date);\n      var x = function (t) { return L + (t - t0) / (t1 - t0) * (W - L - R); };\n      var y = function (v) { return T + (1 - v / MAX) * (H - T - B); };\n      var font = \"font-family:inherit\";\n      el(\"text\", { x: L, y: 17, fill: \"#EEEEEE\", \"font-size\": 17, \"font-weight\": 600, style: font }, \"Bitcoin Network Emissions Intensity\");\n      el(\"text\", { x: 11, y: (T + H - B) / 2, fill: \"#B8C0CC\", \"font-size\": 11, \"text-anchor\": \"middle\", transform: \"rotate(-90 11 \" + ((T + H - B) / 2) + \")\", style: font }, \"gCO2e per kWh\");\n      for (var v = 0; v <= MAX; v += 100) {\n        el(\"line\", { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: v === 0 ? \"rgba(238,238,238,0.4)\" : \"rgba(238,238,238,0.09)\", \"stroke-width\": v === 0 ? 1.5 : 1 });\n        el(\"text\", { x: L - 8, y: y(v) + 4, fill: \"#B8C0CC\", \"font-size\": 13, \"text-anchor\": \"end\", style: font }, v);\n      }\n      var y0 = new Date(t0).getUTCFullYear() + 1, y1 = new Date(t1).getUTCFullYear();\n      for (var yr = y0; yr <= y1; yr++) {\n        el(\"text\", { x: x(Date.UTC(yr, 0, 1)), y: H - 8, fill: \"#B8C0CC\", \"font-size\": 13, \"text-anchor\": \"middle\", style: font }, yr);\n      }\n      var net = function (r) { return r.intensity_g_kwh * r.net_mt / r.gross_mt; };\n      var g = rows.filter(function (r) { return r.grid_g_kwh; });\n      el(\"path\", { d: g.map(function (r, i) { return (i ? \"L\" : \"M\") + x(Date.parse(r.date)).toFixed(1) + \" \" + y(r.grid_g_kwh).toFixed(1); }).join(\" \"), fill: \"none\", stroke: GRID, \"stroke-width\": 2.2, \"stroke-linejoin\": \"round\" });\n      el(\"path\", { d: rows.map(function (r, i) { return (i ? \"L\" : \"M\") + x(Date.parse(r.date)).toFixed(1) + \" \" + y(net(r)).toFixed(1); }).join(\" \"), fill: \"none\", stroke: NET, \"stroke-width\": 2.6, \"stroke-linejoin\": \"round\" });\n      var last = rows[rows.length - 1], lx = x(t1);\n      var gl = g[g.length - 1].grid_g_kwh, nl = net(last);\n      el(\"circle\", { cx: lx, cy: y(gl), r: 5, fill: GRID, stroke: \"#092142\", \"stroke-width\": 2 });\n      el(\"text\", { x: lx, y: y(gl) - 22, fill: \"#EEEEEE\", \"font-size\": 15, \"font-weight\": 700, \"text-anchor\": \"end\", style: font }, \"Banking sector \" + Math.round(gl));\n      el(\"circle\", { cx: lx, cy: y(nl), r: 5, fill: NET, stroke: \"#092142\", \"stroke-width\": 2 });\n      el(\"text\", { x: lx, y: y(nl) + 24, fill: \"#EEEEEE\", \"font-size\": 15, \"font-weight\": 700, \"text-anchor\": \"end\", style: font }, \"Bitcoin (net) \" + Math.round(nl));\n    })\n    .catch(function () { svg.parentNode.style.display = \"none\"; });\n})();\n</script></div>\n  </div>\n  <a class=\"bz-viz-more\" href=\"https://batcoinz.com/beest/\">More Bitcoin and energy live charts \u2192</a>\n</section>\n<style>\n/* Hero: the portal line and heading on the left, \"Start here\" in the right-hand column. */\n#bz-home .bz-hero{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:40px 0 50px}\n#bz-home .bz-hero .bz-h1{padding:0!important;margin:0}\n#bz-home .bz-portal{font-size:18px;color:#8FDCA6;margin:0 0 12px}\n#bz-home .bz-hero .bz-start{margin:0;flex:0 0 auto;text-align:right}\n@media (max-width:820px){#bz-home .bz-hero{flex-direction:column;align-items:flex-start;gap:18px;padding:28px 0 24px}#bz-home .bz-hero .bz-start{text-align:left}#bz-home .bz-viz2 .bz-charts{grid-template-columns:1fr!important}}\n</style>\n<style>\n/* Homepage v2 layout: four figures full width (2x2), then two live charts s
{"c": "<!-- wp:html -->\n<style>\nbody{background:#0A1A2F!important}\n#bz-home{background:#0A1A2F;color:#EEF2F5;font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.5}\n#bz-home *{box-sizing:border-box}\n#bz-home a{color:#8FDCA6;text-decoration:none}\n#bz-home a:hover{color:#B8EBC8;text-decoration:underline}\n#bz-home img{display:block;max-width:100%}\n#bz-home h1,#bz-home h2,#bz-home h3{font-family:Outfit,sans-serif;font-weight:500;color:#EEF2F5;margin:0;letter-spacing:0}\n#bz-home p{margin:0}\n#bz-home .bz-wrap{max-width:1200px;margin:0 auto;padding-left:32px;padding-right:32px}\n#bz-home .bz-header{border-bottom:1px solid rgba(238,242,245,.10)}\n#bz-home .bz-nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:20px;padding-bottom:20px}\n#bz-home .bz-logo{font-family:Outfit,sans-serif;font-weight:600;font-size:32px;letter-spacing:.12em;color:#EEF2F5}\n#bz-home .bz-links{display:flex;flex-wrap:wrap;align-items:center;gap:28px;font-size:15px}\n#bz-home .bz-links a{color:#EEF2F5}\n#bz-home .bz-pill{background:#8FDCA6;color:#0A1A2F!important;font-weight:500;padding:10px 18px;border-radius:999px}\n#bz-home .bz-pill:hover{background:#B8EBC8;text-decoration:none}\n#bz-home .bz-byline{margin:32px 0 16px;font-size:13px;letter-spacing:.14em;text-transform:uppercase}\n#bz-home .bz-banner{width:100%;height:auto;aspect-ratio:5/2;object-fit:cover;border-radius:16px}\n#bz-home .bz-kicker{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#8FDCA6}\n#bz-home .bz-h1{font-size:56px;line-height:1.1;max-width:820px;padding:48px 0 40px}\n#bz-home .bz-feature{display:block;background:#0F2440;border-radius:16px;color:#EEF2F5;padding:48px;margin-bottom:72px}\n#bz-home .bz-feature:hover{text-decoration:none;background:#132B4C}\n#bz-home .bz-feature-inner{max-width:820px;display:flex;flex-direction:column;gap:16px}\n#bz-home .bz-feature h2{font-size:34px;line-height:1.2}\n#bz-home .bz-feature p{font-size:17px;line-height:1.6;color:#B9C5D3}\n#bz-home .bz-more{font-size:15px;font-weight:500;color:#8FDCA6}\n#bz-home .bz-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:28px}\n#bz-home .bz-row h2{font-size:28px}\n#bz-home .bz-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px;margin-bottom:80px}\n#bz-home .bz-card{display:flex;flex-direction:column;background:#0F2440;border-radius:14px;overflow:hidden;color:#EEF2F5}\n#bz-home .bz-card:hover{text-decoration:none;background:#132B4C}\n#bz-home .bz-card img{width:100%;height:190px;object-fit:cover;object-position:top}\n#bz-home .bz-card-body{padding:22px 24px 26px;display:flex;flex-direction:column;gap:10px}\n#bz-home .bz-date{font-size:13px;color:#A9B6C6}\n#bz-home .bz-card h3{font-size:21px;line-height:1.3}\n#bz-home .bz-band{background:#0F2440;border-top:1px solid rgba(238,242,245,.08);border-bottom:1px solid rgba(238,242,245,.08)}\n#bz-home .bz-band-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:center;padding-top:56px;padding-bottom:56px}\n#bz-home .bz-stack{display:flex;flex-direction:column;gap:14px;align-items:flex-start}\n#bz-home .bz-band h2{font-size:30px;line-height:1.2}\n#bz-home .bz-chai{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:40px;padding-top:64px;padding-bottom:64px}\n#bz-home .bz-chai img{width:240px;height:240px;border-radius:16px}\n#bz-home .bz-chai-text{flex:0 1 460px;display:flex;flex-direction:column;gap:14px;align-items:flex-start}\n#bz-home .bz-chai h2{font-size:30px;line-height:1.2}\n#bz-home .bz-chai p{font-size:16px;line-height:1.6;color:#B9C5D3}\n#bz-home .bz-tip{background:#E4F060;color:#0A1A2F!important;font-weight:500;padding:13px 24px;border-radius:999px}\n#bz-home .bz-tip:hover{text-decoration:none;background:#EEF59A}\n#bz-home .bz-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;font-size:14px;color:#A9B6C6;padding-top:36px;padding-bottom:48px}\n@media (max-width:700px){\n#bz-home .bz-wrap{padding-left:16px;padding-right:16px}\n#bz-home .bz-logo{font-size:26px}\n#bz-home .bz-links{gap:16px}\n#bz-home .bz-h1{font-size:38px;padding:32px 0 28px}\n#bz-home .bz-feature{padding:28px}\n#bz-home .bz-feature h2{font-size:27px}\n#bz-home .bz-grid{grid-template-columns:1fr}\n}\n\n#bz-home .bz-intro{font-size:18px;line-height:1.6;color:#B9C5D3;margin:-24px 0 40px}\n#bz-home .bz-morebtn{display:block;margin:0 auto 80px;background:#8FDCA6;color:#0A1A2F;border:0;font:500 16px Inter,sans-serif;padding:13px 28px;border-radius:999px;cursor:pointer}\n#bz-home .bz-morebtn:hover{background:#B8EBC8}\n#bz-home .bz-morebtn[hidden]{display:none}\n</style>\n<div id=\"bz-home\">\n  <header class=\"bz-header\">\n    <nav class=\"bz-wrap bz-nav\">\n      <a class=\"bz-logo\" href=\"/\">BATCOINZ</a>\n      <div class=\"bz-links\">\n        <a href=\"/start-here/\">Start here</a>\n        <a href=\"/articles/\">Articles</a>\n        <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a>\n        <a href=\"/media/\">Media</a>\n        <a href=\"/about/\">About</a>\n        <a href=\"https://www.danielbatten.co\">Bitcoiner coaching</a>\n        <a class=\"bz-pill\" href=\"https://newsletter.batcoinz.com/\">Newsletter</a>\n      </div>\n    </nav>\n  </header>\n\n  <div class=\"bz-wrap\">\n    <h1 class=\"bz-h1\">Start here</h1>\n    <p class=\"bz-intro\">New to Bitcoin and energy? Read these five in order. They go from what Bitcoin is to where it is heading, then the quick answers.</p>\n    <ol class=\"bz-steps\">\n      <li><a class=\"bz-step\" href=\"/bitcoin-lets-start-from-scratch/\"><img src=\"/wp-content/uploads/2026/11/2022_10_image-opt.jpg\" alt=\"\" fetchpriority=\"high\"><span class=\"bz-step-body\"><span class=\"bz-step-n\">1</span><span class=\"bz-step-t\">Bitcoin: let\u2019s start from scratch</span><span class=\"bz-step-d\">What Bitcoin is, who uses it, and what it means for the environment.</span></span></a></li>\n      <li><a class=\"bz-step\" href=\"/the-changing-narrative-on-bitcoin-mining/\"><img src=\"/wp-content/uploads/2026/11/bitcoin-and-energy-reporting-v4.jpg\" alt=\"\" loading=\"lazy\"><span class=\"bz-step-body\"><span class=\"bz-step-n\">2</span><span class=\"bz-step-t\">The new (data-backed) story about Bitcoin mining</span><span class=\"bz-step-d\">What researchers, grid operators and journalists now say about Bitcoin mining, and the data behind the shift.</span></span></a></li>\n      <li><a class=\"bz-step\" href=\"/common-bitcoin-energy-misconceptions/\"><img src=\"/wp-content/uploads/2026/11/misconceptions-G9wG9XLXkAED1KV.jpg\" alt=\"\" loading=\"lazy\"><span class=\"bz-step-body\"><span class=\"bz-step-n\">3</span><span class=\"bz-step-t\">Common Bitcoin energy misconceptions</span><span class=\"bz-step-d\">Evidence-based answers to the nine most common claims about Bitcoin and energy.</span></span></a></li>\n      <li><a class=\"bz-step\" href=\"/bitcoin-could-be-carbon-negative-by-2031-here-are-5-ways-it-gets-there/\"><img src=\"/wp-content/uploads/2026/11/1.jpeg\" alt=\"\" loading=\"lazy\"><span class=\"bz-step-body\"><span class=\"bz-step-n\">4</span><span class=\"bz-step-t\">Bitcoin could be carbon negative by 2031. Here are 5 ways it gets there</span><span class=\"bz-step-d\">Five ways Bitcoin offsets its emissions, and the year the offsets could become larger than the emissions.</span></span></a></li>\n      <li><a class=\"bz-step\" href=\"/bitcoin-energy-facts/\"><img src=\"/wp-content/uploads/2026/11/bitcoin-energy-facts-step.webp\" alt=\"Sustainably powered? Yes. Wastes energy? No. Trending carbon negative? Yes.\" loading=\"lazy\" width=\"880\" height=\"560\"><span class=\"bz-step-body\"><span class=\"bz-step-n\">5</span><span class=\"bz-step-t\">Bitcoin energy facts</span><span class=\"bz-step-d\">Short answers to the questions people most often ask about Bitcoin, energy and the environment, backed by the latest peer-reviewed research and independent reports.</span></span></a></li>\n    </ol>\n    <p class=\"bz-intro\" style=\"margin-top:36px\">Then browse <a href=\"/articles/\">all articles by topic</a>, or follow the figures live on the <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a>.</p>\n  </div>\n<style>\n#bz-home .bz-steps{list-style:none;margin:8px 0 0;padding:0;display:grid;gap:18px}\n#bz-home .bz-step{display:grid;grid-template-columns:220px 1fr;gap:22px;align-items:center;background:#0F2440;border:1px solid rgba(238,242,245,.08);border-radius:14px;overflow:hidden;color:#EEF2F5;text-decoration:none}\n#bz-home .bz-step:hover{border-color:#8FDCA6}\n#bz-home .bz-step img{width:100%;height:140px;object-fit:contain;background:#0A1A2F;display:block}\n#bz-home .bz-step-body{display:flex;flex-direction:column;gap:6px;padding:16px 20px 16px 0;min-width:0}\n#bz-home .bz-step-n{font-size:13px;letter-spacing:.14em;color:#8FDCA6;font-weight:600}\n#bz-home .bz-step-t{font-family:Outfit,Inter,system-ui,sans-serif;font-size:21px;font-weight:600;line-height:1.25}\n#bz-home .bz-step-d{color:#B8C4D0;font-size:15px;line-height:1.5}\n@media (max-width:640px){#bz-home .bz-step{grid-template-columns:1fr;gap:0}#bz-home .bz-step img{height:auto}#bz-home .bz-step-body{padding:14px 16px 18px}}\n</style>\n\n  <footer class=\"bz-wrap bz-footer\">\n    <span>\u00a9 <span id=\"bz-year\">2026</span> Batcoinz</span>\n    <span><a href=\"https://www.danielbatten.co\">Bitcoiner coaching</a> \u00b7 <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a> \u00b7 <a href=\"https://newsletter.batcoinz.com/\">Newsletter</a> \u00b7 <a href=\"/bitcoin-energy-facts/\">Key facts</a> \u00b7 <a href=\"/misinformation-archive/\">Misinformation archive</a></span>\n  </footer>\n</div>\n\n<!-- /wp:html --><script>(function(){var y=document.getElementById(\"bz-year\");if(y)y.textContent=new Date().getFullYear();})();</script>"}
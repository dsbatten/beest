{"c": "<!-- wp:html -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\nbody{background:#0A1A2F!important}\n#bz-home{background:#0A1A2F;color:#EEF2F5;font-family:Inter,system-ui,sans-serif;font-size:16px;line-height:1.5}\n#bz-home *{box-sizing:border-box}\n#bz-home a{color:#8FDCA6;text-decoration:none}\n#bz-home a:hover{color:#B8EBC8;text-decoration:underline}\n#bz-home img{display:block;max-width:100%}\n#bz-home h1,#bz-home h2,#bz-home h3{font-family:Outfit,sans-serif;font-weight:500;color:#EEF2F5;margin:0;letter-spacing:0}\n#bz-home p{margin:0}\n#bz-home .bz-wrap{max-width:1200px;margin:0 auto;padding-left:32px;padding-right:32px}\n#bz-home .bz-header{border-bottom:1px solid rgba(238,242,245,.10)}\n#bz-home .bz-nav{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:20px;padding-bottom:20px}\n#bz-home .bz-logo{font-family:Outfit,sans-serif;font-weight:600;font-size:32px;letter-spacing:.12em;color:#EEF2F5}\n#bz-home .bz-links{display:flex;flex-wrap:wrap;align-items:center;gap:28px;font-size:15px}\n#bz-home .bz-links a{color:#EEF2F5}\n#bz-home .bz-pill{background:#8FDCA6;color:#0A1A2F!important;font-weight:500;padding:10px 18px;border-radius:999px}\n#bz-home .bz-pill:hover{background:#B8EBC8;text-decoration:none}\n#bz-home .bz-byline{margin:32px 0 16px;font-size:13px;letter-spacing:.14em;text-transform:uppercase}\n#bz-home .bz-banner{width:100%;height:auto;aspect-ratio:5/2;object-fit:cover;border-radius:16px}\n#bz-home .bz-kicker{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#8FDCA6}\n#bz-home .bz-h1{font-size:56px;line-height:1.1;max-width:820px;padding:48px 0 40px}\n#bz-home .bz-feature{display:block;background:#0F2440;border-radius:16px;color:#EEF2F5;padding:48px;margin-bottom:72px}\n#bz-home .bz-feature:hover{text-decoration:none;background:#132B4C}\n#bz-home .bz-feature-inner{max-width:820px;display:flex;flex-direction:column;gap:16px}\n#bz-home .bz-feature h2{font-size:34px;line-height:1.2}\n#bz-home .bz-feature p{font-size:17px;line-height:1.6;color:#B9C5D3}\n#bz-home .bz-more{font-size:15px;font-weight:500;color:#8FDCA6}\n#bz-home .bz-row{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:28px}\n#bz-home .bz-row h2{font-size:28px}\n#bz-home .bz-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px;margin-bottom:80px}\n#bz-home .bz-card{display:flex;flex-direction:column;background:#0F2440;border-radius:14px;overflow:hidden;color:#EEF2F5}\n#bz-home .bz-card:hover{text-decoration:none;background:#132B4C}\n#bz-home .bz-card img{width:100%;height:190px;object-fit:cover;object-position:top}\n#bz-home .bz-card-body{padding:22px 24px 26px;display:flex;flex-direction:column;gap:10px}\n#bz-home .bz-date{font-size:13px;color:#A9B6C6}\n#bz-home .bz-card h3{font-size:21px;line-height:1.3}\n#bz-home .bz-band{background:#0F2440;border-top:1px solid rgba(238,242,245,.08);border-bottom:1px solid rgba(238,242,245,.08)}\n#bz-home .bz-band-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;align-items:center;padding-top:56px;padding-bottom:56px}\n#bz-home .bz-stack{display:flex;flex-direction:column;gap:14px;align-items:flex-start}\n#bz-home .bz-band h2{font-size:30px;line-height:1.2}\n#bz-home .bz-chai{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:40px;padding-top:64px;padding-bottom:64px}\n#bz-home .bz-chai img{width:240px;height:240px;border-radius:16px}\n#bz-home .bz-chai-text{flex:0 1 460px;display:flex;flex-direction:column;gap:14px;align-items:flex-start}\n#bz-home .bz-chai h2{font-size:30px;line-height:1.2}\n#bz-home .bz-chai p{font-size:16px;line-height:1.6;color:#B9C5D3}\n#bz-home .bz-tip{background:#E4F060;color:#0A1A2F!important;font-weight:500;padding:13px 24px;border-radius:999px}\n#bz-home .bz-tip:hover{text-decoration:none;background:#EEF59A}\n#bz-home .bz-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;font-size:14px;color:#A9B6C6;padding-top:36px;padding-bottom:48px}\n@media (max-width:700px){\n#bz-home .bz-wrap{padding-left:16px;padding-right:16px}\n#bz-home .bz-logo{font-size:26px}\n#bz-home .bz-links{gap:16px}\n#bz-home .bz-h1{font-size:38px;padding:32px 0 28px}\n#bz-home .bz-feature{padding:28px}\n#bz-home .bz-feature h2{font-size:27px}\n#bz-home .bz-grid{grid-template-columns:1fr}\n}\n\n#bz-home .bz-intro{font-size:18px;line-height:1.6;color:#B9C5D3;margin:-24px 0 40px}\n#bz-home .bz-morebtn{display:block;margin:0 auto 80px;background:#8FDCA6;color:#0A1A2F;border:0;font:500 16px Inter,sans-serif;padding:13px 28px;border-radius:999px;cursor:pointer}\n#bz-home .bz-morebtn:hover{background:#B8EBC8}\n#bz-home .bz-morebtn[hidden]{display:none}\n</style>\n<div id=\"bz-home\">\n  <header class=\"bz-header\">\n    <nav class=\"bz-wrap bz-nav\">\n      <a class=\"bz-logo\" href=\"/\">BATCOINZ</a>\n      <div class=\"bz-links\">\n        <a href=\"/start-here/\">Start here</a>\n        <a href=\"/articles/\">Articles</a>\n        <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a>\n        <a href=\"/media/\">Media</a>\n        <a href=\"/about/\">About</a>\n        <a href=\"https://www.danielbatten.co\">Bitcoiner coaching</a>\n        <a class=\"bz-pill\" href=\"https://newsletter.batcoinz.com/\">Newsletter</a>\n      </div>\n    </nav>\n  </header>\n\n  <div class=\"bz-wrap\">\n    <h1 class=\"bz-h1\">Articles</h1>\n    <p class=\"bz-intro\" id=\"bz-count\">All articles</p>\n<label class=\"bz-search\" style=\"display:block;position:relative;margin:0 0 16px;max-width:560px\"><span style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)\">Search articles</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" style=\"position:absolute;left:14px;top:50%;transform:translateY(-50%)\" fill=\"none\" stroke=\"#8FDCA6\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg><input id=\"bz-search\" type=\"search\" placeholder=\"Search articles\" autocomplete=\"off\" style=\"width:100%;box-sizing:border-box;background:rgba(238,242,245,.06);border:1px solid rgba(238,242,245,.28);border-radius:999px;padding:11px 16px 11px 42px;color:#EEF2F5;font:500 16px/1.2 Inter,system-ui,sans-serif\"></label>\n<div class=\"bz-filters\" id=\"bz-filters\" role=\"group\" aria-label=\"Filter articles by topic\"></div>\n\n    <div class=\"bz-grid\" id=\"bz-grid\" style=\"margin-bottom:40px\">[bz_article_index]</div>\n    <button class=\"bz-morebtn\" id=\"bz-more-btn\" type=\"button\" hidden>Show more articles</button>\n  </div>\n\n  <style>\n#bz-home .bz-filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 28px}\n#bz-home .bz-filter{background:transparent;border:1px solid rgba(238,242,245,.22);color:#EEF2F5;border-radius:999px;padding:8px 15px;font:500 14px/1.2 Inter,system-ui,sans-serif;cursor:pointer;text-transform:none;letter-spacing:normal;box-shadow:none}\n#bz-home .bz-filter:hover{border-color:#8FDCA6}\n#bz-home .bz-filter.on{background:#8FDCA6;border-color:#8FDCA6;color:#092142}\n#bz-home .bz-hub{color:#8FDCA6}\n</style>\n<script>\n(function () {\n  // Article cards from the WordPress REST API, filtered by topic hub (WordPress categories).\n  // Misinformation-archive posts stay live at their URLs but are left out of this list.\n  var ARCHIVE = 39;\n  var HUBS = [\n    { id: 0, name: \"All\", slug: \"\" },\n    { id: 33, name: \"Energy and the grid\", slug: \"energy-and-the-grid\" },\n    { id: 34, name: \"Methane\", slug: \"methane\" },\n    { id: 35, name: \"Emissions and data\", slug: \"emissions-and-data\" },\n    { id: 36, name: \"Money and human rights\", slug: \"money-and-human-rights\" },\n    { id: 37, name: \"Adoption and investors\", slug: \"adoption-and-investors\" },\n    { id: 44, name: \"For policymakers and regulators\", slug: \"for-policymakers-and-regulators\" },\n    { id: 45, name: \"Inspiring stories\", slug: \"inspiring-stories\" },\n    { id: 38, name: \"Reflections\", slug: \"reflections\" }\n  ];\n  var NAME = {}; HUBS.forEach(function (h) { if (h.id) NAME[h.id] = h.name; });\n  var UP = \"/wp-content/uploads/2026/11/\";\n  var DESIGNED = {\n    \"banking-on-biometrics-is-fraud-prevention-the-real-goal\": UP + \"article-banking-on-biometrics.png\",\n    \"the-changing-narrative-on-bitcoin-mining\": UP + \"article-new-data-backed-story.png\",\n    \"fact-and-fiction-in-bitcoin-mining-reporting\": UP + \"article-fact-and-fiction.png\",\n    \"bitcoin-coverage-as-a-litmus-test-for-media-reliability\": UP + \"article-litmus-test.png\"\n  };\n  var FALLBACK = UP + \"batcoinz-banner-five-paths-scaled.png\";\n  var MONTHS = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\n  window.addEventListener(\"DOMContentLoaded\", function () { var yel = document.getElementById(\"bz-year\"); if (yel) yel.textContent = new Date().getFullYear(); });\n  function fmt(d) { var t = new Date(d); return t.getDate() + \" \" + MONTHS[t.getMonth()] + \" \" + t.getFullYear(); }\n  function firstImage(html) { var m = /<img[^>]+src=\"([^\"]+)\"/i.exec(html || \"\"); return m ? m[1] : \"\"; }\n  var grid = document.getElementById(\"bz-grid\"), btn = document.getElementById(\"bz-more-btn\"), count = document.getElementById(\"bz-count\");\n  var bar = document.getElementById(\"bz-filters\");\n  var page = 1, busy = false, hub = HUBS[0], seq = 0, q = \"\";\n  // The server builds every article card into the page (12 shown, the rest hidden) so crawlers see all of them.\n  // On the opening \"All\" view the script keeps those cards and \"Show more\" reveals the hidden ones;\n  // a filter or a search switches back to loading cards from the REST API.\n  var ssr = false;\n  HUBS.forEach(function (h) {\n    var b = document.createElement(\"button\"); b.type = \"button\"; b.className = \"bz-filter\"; b.textContent = h.name; b.dataset.slug = h.slug;\n    b.addEventListener(\"click\", function () { select(h, true); });\n    bar.appendChild(b);\n  });\n  function select(h, push, keep) {\n    hub = h; page = 1; ssr = !!keep; if (!keep) grid.innerHTML = \"\";\n    [].forEach.call(bar.children, function (b) { var on = b.dataset.slug === h.slug; b.classList.toggle(\"on\", on); b.setAttribute(\"aria-pressed\", on); });\n    if (push) { try { history.replaceState(null, \"\", h.slug ? \"#\" + h.slug : location.pathname); } catch (e) {} }\n    if (keep) { var n = grid.querySelectorAll(\".bz-card\").length; count.textContent = n + (n === 1 ? \" article\" : \" articles\"); btn.hidden = !grid.querySelector(\".bz-ssr-hidden\"); return; }\n    load();\n  }\n  function load() {\n    var my = ++seq; busy = true; btn.disabled = true; btn.textContent = \"Loading\u2026\";\n    var filter = (hub.id ? \"&categories=\" + hub.id : \"&categories_exclude=\" + ARCHIVE + \",41\") + (q ? \"&search=\" + encodeURIComponent(q) + \"&orderby=relevance\" : \"\");\n    fetch(\"/wp-json/wp/v2/posts?per_page=12&page=\" + page + filter + \"&_embed=wp:featuredmedia&_fields=slug,date,link,title,content,categories,_links,_embedded\")\n      .then(function (r) {\n        if (my !== seq) return [];\n        var total = r.headers.get(\"X-WP-Total\"), pages = +r.headers.get(\"X-WP-TotalPages\") || 1;\n        btn.hidden = page >= pages; btn.disabled = false; btn.textContent = \"Show more articles\"; busy = false;\n        if (total || q) count.textContent = (total || 0) + (total === \"1\" ? \" article\" : \" articles\") + (q ? \" matching \u201c\" + q + \"\u201d\" : \"\") + (hub.id ? \" in \" + hub.name : \"\");\n        return r.json();\n      })\n      .then(function (posts) {\n        if (my !== seq) return;\n        posts.forEach(function (p) {\n          var fm = p._embedded && p._embedded[\"wp:featuredmedia\"] && p._embedded[\"wp:featuredmedia\"][0];\n          var img = (fm && fm.source_url) || DESIGNED[p.slug] || firstImage(p.content.rendered) || FALLBACK;\n          var a = document.createElement(\"a\"); a.className = \"bz-card\"; a.href = p.link;\n          var im = document.createElement(\"img\"); im.src = img; im.alt = \"\"; im.loading = \"lazy\";\n          im.onerror = function () { if (im.src.indexOf(FALLBACK) < 0) im.src = FALLBACK; };\n          var body = document.createElement(\"div\"); body.className = \"bz-card-body\";\n          var d = document.createElement(\"span\"); d.className = \"bz-date\"; d.textContent = fmt(p.date);\n          var hn = (p.categories || []).map(function (c) { return NAME[c]; }).filter(Boolean)[0];\n          if (hn) { if (!hub.id) { var s = document.createElement(\"span\"); s.className = \"bz-hub\"; s.textContent = \" \u00b7 \" + hn; d.appendChild(s); } }\n          var h = document.createElement(\"h3\"); h.innerHTML = p.title.rendered;\n          body.appendChild(d); body.appendChild(h); a.appendChild(im); a.appendChild(body); grid.appendChild(a);\n        });\n      })\n      .catch(function () { busy = false; btn.disabled = false; btn.textContent = \"Show more articles\"; });\n  }\n  btn.addEventListener(\"click\", function () {\n    if (ssr) { [].slice.call(grid.querySelectorAll(\".bz-ssr-hidden\"), 0, 12).forEach(function (e) { e.classList.remove(\"bz-ssr-hidden\"); }); btn.hidden = !grid.querySelector(\".bz-ssr-hidden\"); return; }\n    if (!busy) { page++; load(); }\n  });\n  var sbox = document.getElementById(\"bz-search\"), stimer;\n  if (sbox) sbox.addEventListener(\"input\", function () { clearTimeout(stimer); stimer = setTimeout(function () { var v = sbox.value.trim(); if (v === q) return; q = v; page = 1; ssr = false; grid.innerHTML = \"\"; load(); }, 300); });\n  var start = HUBS.filter(function (h) { return h.slug ? \"#\" + h.slug === location.hash : false; })[0] || HUBS[0];\n  select(start, false, (start === HUBS[0] ? grid.querySelector(\".bz-card\") !== null : false));\n})();\n</script>\n  <footer class=\"bz-wrap bz-footer\">\n    <span>\u00a9 <span id=\"bz-year\">2026</span> Batcoinz</span>\n    <span><a href=\"https://www.danielbatten.co\">Bitcoiner coaching</a> \u00b7 <a href=\"https://batcoinz.com/beest/\">BEEST tracker</a> \u00b7 <a href=\"https://newsletter.batcoinz.com/\">Newsletter</a> \u00b7 <a href=\"/misinformation-archive/\">Misinformation archive</a></span>\n  </footer>\n</div>\n\n<!-- /wp:html -->"}